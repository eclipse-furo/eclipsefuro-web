    "packages/*"
  ],
  "private": true,
  "type": "module",
  "description": "Collection of furo base components",
  "devDependencies": {
    "lerna": "^9.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@axe-core/reporter-earl": "^4.10.2",
    "@babel/preset-env": "^7.28.3",
