{
  "name": "furo-base-components",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "type": "module",
  "description": "Collection of furo base components",
  "devDependencies": {
    "lerna": "^9.0.0",
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@eslint/js": "^10.0.0",
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.2",
    "@vitest/browser": "^4.0.1",
    "@vitest/browser-playwright": "^4.0.1",
    "@vitest/coverage-istanbul": "^4.0.1",
    "@vitest/ui": "^4.0.1",
    "cem-plugin-vs-code-custom-data-generator": "^1.4.2",
    "concurrently": "^9.2.1",
    "custom-element-jet-brains-integration": "^1.7.0",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-lit-a11y": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-wc": "^3.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.11",
    "vitest": "^4.0.1",
    "@open-wc/testing-helpers": "^3.0.1",
    "chai-a11y-axe": "^1.5.0"
  },
  "lint-staged": {
    "packages/furo-layout/**/*.ts": [
      "eslint --fix --config packages/furo-layout/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/furo-channels/**/*.ts": [
      "eslint --fix --config packages/furo-channels/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/furo-route/**/*.ts": [
      "eslint --fix --config packages/furo-route/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/furo-open-models/**/*.ts": [
      "eslint --fix --config packages/furo-open-models/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/furo-{fbp,framework,data,util}/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "yarn install && ./scripts/bootstrap.sh",
    "test:all": "lerna run test",
    "test:all:watch": "lerna run test:watch",
    "lint:all": "lerna run lint",
    "docs:start": "cd hugo && hugo serve",
    "docs:generate": "./scripts/cem.sh",
    "docs:publish": "./scripts/publishDocs.sh"
  },
  "author": "veith",
  "license": "MIT"
}
