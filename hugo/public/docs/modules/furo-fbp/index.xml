      <description>&lt;h1 id=&#34;domfbp&#34;&gt;&#xA;  DOMFBP&#xA;  &lt;a class=&#34;anchor&#34; href=&#34;#domfbp&#34;&gt;#&lt;/a&gt;&#xA;&lt;/h1&gt;&#xA;&lt;p&gt;&lt;strong&gt;@furo/furo-fbp&lt;/strong&gt; &lt;small&gt;v6.11.0&lt;/small&gt;&#xA;&lt;br&gt;&lt;code&gt;import &#39;@furo/fbp/src/DOMFBP.js&#39;;&lt;/code&gt;&lt;small&gt;&#xA;&lt;br&gt;exports &lt;em&gt;DOMFBP&lt;/em&gt; js&#xA;&lt;br&gt;extends &lt;em&gt;src/DOMFBP.js&lt;/em&gt;&#xA;&lt;br&gt; mixes &lt;em&gt;FBP&lt;/em&gt;&lt;/small&gt;&lt;/p&gt;&#xA;&lt;hr&gt;&#xA;&lt;p&gt;DOMFBP allows you to append FBP to any dom element.&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Usage:&lt;/strong&gt;&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;div style=&#34;background-color:#fff;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&#xA;&lt;table style=&#34;border-spacing:0;padding:0;margin:0;border:0;&#34;&gt;&lt;tr&gt;&lt;td style=&#34;vertical-align:top;padding:0;margin:0;border:0;&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; style=&#34;background-color:#fff;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 1&#xA;&lt;/span&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 2&#xA;&lt;/span&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 3&#xA;&lt;/span&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 4&#xA;&lt;/span&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 5&#xA;&lt;/span&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.