{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openapi.v3.PathItem.json",
  "type": "object",
  "description": "Describes the operations available on a single path. A Path Item MAY be empty, due to ACL constraints. The path itself is still exposed to the documentation viewer but they will not know which operations and parameters are available.PathItem",
  "properties": {
    "Ref": {
      "type": "string"
    },
    "delete": {
      "$ref": "openapi.v3.Operation.json"
    },
    "description": {
      "type": "string"
    },
    "get": {
      "$ref": "openapi.v3.Operation.json"
    },
    "head": {
      "$ref": "openapi.v3.Operation.json"
    },
    "options": {
      "$ref": "openapi.v3.Operation.json"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "openapi.v3.ParameterOrReference.json"
      }
    },
    "patch": {
      "$ref": "openapi.v3.Operation.json"
    },
    "post": {
      "$ref": "openapi.v3.Operation.json"
    },
    "put": {
      "$ref": "openapi.v3.Operation.json"
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "openapi.v3.Server.json"
      }
    },
    "specificationExtension": {
      "type": "array",
      "items": {
        "$ref": "openapi.v3.NamedAny.json"
      }
    },
    "summary": {
      "type": "string"
    },
    "trace": {
      "$ref": "openapi.v3.Operation.json"
    }
  }
}