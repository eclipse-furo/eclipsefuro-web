{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "google.protobuf.DescriptorProto.json",
  "type": "object",
  "description": "Describes a message type.DescriptorProto",
  "properties": {
    "enumType": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.EnumDescriptorProto.json"
      }
    },
    "extension": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.FieldDescriptorProto.json"
      }
    },
    "extensionRange": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.DescriptorProto.ExtensionRange.json"
      }
    },
    "field": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.FieldDescriptorProto.json"
      }
    },
    "name": {
      "type": "string"
    },
    "nestedType": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.DescriptorProto.json"
      }
    },
    "oneofDecl": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.OneofDescriptorProto.json"
      }
    },
    "options": {
      "$ref": "google.protobuf.MessageOptions.json"
    },
    "reservedName": {
      "type": "array",
      "description": "Reserved field names, which may not be used by fields in the same message.\n A given name may only be reserved once.",
      "items": {
        "type": "string"
      }
    },
    "reservedRange": {
      "type": "array",
      "items": {
        "$ref": "google.protobuf.DescriptorProto.ReservedRange.json"
      }
    }
  }
}