{
  "extends": "../../.eslintrc-ts-base.json",
  "parserOptions": {
    "project": [
      "./tsconfig.json",
      "./test/tsconfig.json"
    ]
  },
  "overrides": [
    {
      "files": ["src/JSX/*"],
      "rules": {
        "require-jsdoc": "off",
        "import/extensions": "off",
        "import/no-duplicates": "off"
      }
    },
    {
      "files": ["test/pages/*"],
      "rules": {
        "require-jsdoc": "off",
        "import/extensions": "off"
      }
    },
    {
      "files": ["test/specs/*"],
      "rules": {
        "require-jsdoc": "off",
        "import/extensions": "off"
      }
    }
  ]
}
