{
  "name": "@furo/layout",
  "version": "3.0.0-RC.11",
  "description": "Layout components for furo",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json",
    "./web-types.json": "./web-types.json",
    "./furo-backdrop": {
      "types": "./dist/components/furo-backdrop/FuroBackdrop.d.ts",
      "default": "./dist/components/furo-backdrop/index.js"
    },
    "./furo-horizontal-flex": {
      "types": "./dist/components/furo-horizontal-flex/FuroHorizontalFlex.d.ts",
      "default": "./dist/components/furo-horizontal-flex/index.js"
    },
    "./furo-layout-indent": {
      "types": "./dist/components/furo-layout-indent/FuroLayoutIndent.d.ts",
      "default": "./dist/components/furo-layout-indent/index.js"
    },
    "./furo-resizer": {
      "types": "./dist/components/furo-resizer/FuroResizer.d.ts",
      "default": "./dist/components/furo-resizer/index.js"
    },
    "./furo-responsive-layout": {
      "types": "./dist/components/furo-responsive-layout/FuroResponsiveLayout.d.ts",
      "default": "./dist/components/furo-responsive-layout/index.js"
    },
    "./furo-vertical-flex": {
      "types": "./dist/components/furo-vertical-flex/FuroVerticalFlex.d.ts",
      "default": "./dist/components/furo-vertical-flex/index.js"
    },
    "./furo-split-view": {
      "types": "./dist/components/furo-split-view/FuroSplitView.d.ts",
      "default": "./dist/components/furo-split-view/index.js"
    },
    "./furo-empty-spacer": {
      "types": "./dist/components/furo-empty-spacer/FuroEmptySpacer.d.ts",
      "default": "./dist/components/furo-empty-spacer/index.js"
    },
    "./furo-vertical-scroller": {
      "types": "./dist/components/furo-vertical-scroller/FuroVerticalScroller.d.ts",
      "default": "./dist/components/furo-vertical-scroller/index.js"
    }
  },
  "customElements": "custom-elements.json",
  "web-types": "./web-types.json",
  "homepage": "https://github.com/eclipse/eclipsefuro-web/tree/main/packages/furo-layout",
  "repository": "git@github.com:eclipse/eclipsefuro-web.git",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "keywords": [
    "web-components",
    "flow based programming",
    "fbp"
  ],
  "files": [
    "./dist",
    "icon.svg",
    "README.md",
    "custom-elements.json",
    "web-types.json"
  ],
  "scripts": {
    "start": "tsc && concurrently -k -r 'vite dev' 'tsc --watch'",
    "test": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism --isolate false",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "build": "rimraf dist  &&rimraf src/JSX/*  && npm run analyze && npm run analyze:internal && npm run analyze:deep &&   tsc && tsc-alias",
    "gen:intrinsic": "node ../../scripts/IntrinsicElements/main.js @furo/layout && eslint --fix src/JSX && prettier src/JSX/*.ts --write",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "lint:fix:tests": "eslint ./test --fix",
    "format": "prettier './src/**/*.ts' --write --ignore-path .gitignore",
    "format:tests": "prettier './test/**/*.ts' --write --ignore-path .gitignore",
    "analyze": "cem analyze --litelement --globs ./src/* --outdir ./dist",
    "analyze:internal": "cem analyze --config scripts/internal-cem.config.mjs && mv tmp/custom-elements.json dist/custom-elements-internal.json",
    "analyze:deep": "cem analyze --config ./scripts/deep-cem.config.mjs &&  ./scripts/WebtypesPostprocessor.mjs && ./scripts/CheckWebtypes.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@furo/fbp": "^6.15.0",
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
