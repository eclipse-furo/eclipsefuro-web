{
  "name": "@furo/channels",
  "description": "A typed channel system to pass data across your application",
  "version": "1.0.0",
  "homepage": "https://github.com/eclipse/eclipsefuro-web/tree/main/packages/furo-channels",
  "repository": "git@github.com:eclipse/eclipsefuro-web.git",
  "author": {
    "name": "veith",
    "email": "",
    "url": "https://github.com/theNorstroem/"
  },
  "keywords": [
    "channels",
    "pub sub like"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "start": "vite dev",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "build": "rimraf dist && tsc && tsc-alias",
    "lint": "eslint --ext .ts,.html ./src ./dev-playground --ignore-path .gitignore",
    "lint:fix": "eslint --ext .ts ./src ./dev-playground --fix --ignore-path .gitignore",
    "lint:fix:tests": "eslint --ext .ts,.html ./test --fix --ignore-path .gitignore",
    "format": "prettier './src/**/*.ts' './dev-playground/**/*.ts' --write --ignore-path .gitignore",
    "format:tests": "prettier './test/**/*.ts' --write --ignore-path .gitignore"
  },
  "peerDependencies": {

  },
  "dependencies": {

  },
  "devDependencies": {


  },
  "publishConfig": {
    "access": "public"
  }
}
